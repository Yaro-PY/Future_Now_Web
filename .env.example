DATABASE_URL=sqlite+aiosqlite:///./website.db
# To share bot profiles, use exactly the same DATABASE_URL in both projects.
# In production this is the shared Neon PostgreSQL connection string.
ADMIN_ID=0
HOST=127.0.0.1
PORT=8002
CATALOG_SOURCES=man,prometheus,diia
CATALOG_SOURCE_LIMIT=12
WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEB_SESSION_DAYS=7
# HTTPS/Vercel detects secure cookies automatically.
# WEB_COOKIE_SECURE=true
WEB_COOKIE_SAMESITE=lax
